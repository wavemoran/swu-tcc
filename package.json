{
  "name": "swu-tcc",
  "version": "1.0.1",
  "private": true,
  "license": "MIT",
  "description": "Star Wars Unlimited Top Cut Calculator: can I intentionally draw and still make top cut?",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*",
    "e2e"
  ],
  "engines": {
    "node": ">=26"
  },
  "packageManager": "npm@11.20.0",
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present && tsc -p tools",
    "e2e": "npm run build && npm run e2e -w @swu-tcc/e2e",
    "check": "npm run typecheck && npm run test"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^5.1.0",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  },
  "allowScripts": {
    "fsevents": false,
    "esbuild@0.28.2": true,
    "workerd@1.20261110.1": true
  }
}
